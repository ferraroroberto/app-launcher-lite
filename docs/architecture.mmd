%% docs/architecture.mmd — app-launcher-lite's own internal structure.
%% Hand-authored, not generated. Update it in the same PR as any material
%% structural change (a new tab/router, a process split, a script relocated):
%% same anti-staleness contract as this repo's own `.fleet.toml`. The layout
%% follows app-launcher's, which this repo is rebuilt from; the differences
%% are the one coding agent (Copilot CLI) and the one forge (GitLab via glab).

flowchart TB
  ENTRY["launcher.py (root)\nputs repo root on sys.path"] --> CLIMAIN["app/cli/main.py"]

  subgraph cli["app/cli/commands/"]
    TRAYCMD["tray_cmd.py"]
    WEBAPPCMD["webapp_cmd.py"]
    HOSTCMD["session_host_cmd.py"]
    SCANCMD["scan_cmd.py"]
    RUNJOBCMD["run_job_cmd.py + run_job_supervision.py\njob executor, output tee, watchdog"]
  end
  CLIMAIN --> TRAYCMD
  CLIMAIN --> WEBAPPCMD
  CLIMAIN --> HOSTCMD
  CLIMAIN --> SCANCMD
  CLIMAIN --> RUNJOBCMD

  subgraph tray["app/tray/"]
    TRAY["tray.py\nmenu: open/copy URL, restart, status, quit"]
    TRAYREGTRAYS["registered_trays.py\nautostart boot sequence"]
    TRAYHEAL["watchdog.py + self_heal.py\nhealth probes, bounded restart"]
  end
  TRAYCMD --> TRAY
  TRAY --> TRAYREGTRAYS
  TRAY --> TRAYHEAL
  TRAY -->|reclaim by .venv-scoped pid| TRAYPS["scripts/tray_lifecycle.ps1\n(vendored, no external dependency)"]

  TRAY -->|spawns, owns subtree| WEBAPPPROC["webapp process :8465"]
  TRAY -->|spawns DETACHED, re-adopts on start\nexcluded from the tray reclaim sweep| HOSTPROC["session-host process :8466"]
  TRAY -->|optional| TUNNEL["cloudflared tunnel"]

  subgraph webapp["app/webapp/ — FastAPI, :8465"]
    WSERVER["server.py\nlifespan ticks, static mount, asset hashing"]
    MGR["manager.py\nWebappManager (start/stop/status)"]
    SHELLHTML["shell_html.py\nsplices static/views/*.html into index.html"]
    PRELOAD["module_preload.py\nmodulepreload links for the first-load module graph"]
    DOORBELL["chief_doorbell.py\nrings an idle chief with pending mail"]
    subgraph routers["routers/"]
      R_MISC["misc.py — /, /healthz, /api/version, /api/system/load"]
      R_AUTH["auth.py — /api/login"]
      R_CONFIG["config.py — /api/config, /api/status\nCopilot, GitLab and Team OS settings"]
      R_COPILOTUSAGE["copilot_usage.py — /api/copilot-usage\nUsage card, answered from memory; src/copilot_usage.py reads the Copilot CLI log in a worker thread"]
      R_DOCUMENTS["documents.py —/api/documents\nallowlisted repo files, read-only"]
      R_TOKENS["tokens.py — /api/tokens\nscoped-token mint/list/revoke"]
      R_APPS["apps.py — /api/apps (Apps tab, Coding launches)"]
      R_SESS["sessions.py — /api/claude-code/sessions, WS"]
      R_CC["claude_code.py — favorites, git-status, VS Code open"]
      R_TRANSCRIPT["session_transcript.py — a session's transcript page\n+ session_outbox_routes.py (agent-sent files)"]
      R_SCREEN["session_screen.py — reads the PTY screen, types keys\n+ session_folder_trust.py (answers Copilot's folder-trust prompt)"]
      R_DESKTOP["desktop_screen.py — /api/screen/*, the PC desktop, passkey-gated"]
      R_JOBS["jobs.py + jobs_run_store_routes.py\n+ jobs_webhook_routes.py + jobs_outbox_routes.py\n/api/jobs/* (Jobs tab)"]
      R_TEAMOS["team_os.py — /api/team-os/* (Team OS tab)\nskills from team_os_dir launched as Copilot sessions"]
      R_BOARD["board.py — /api/board (Board tab), issue start, file issue\n+ board_chief.py (chief ensure/settings)\n+ board_spawn.py (shared spawn-then-type, Copilot flags)\n+ board_owner.py (owner-check answers)"]
      R_PROGRESS["progress.py — /api/progress\nHistory sheet: lines from local git, MRs and issues from GitLab, cached"]
      R_SPEECH["speech.py — /api/transcribe, /api/speech/test\ndictation proxy to an OpenAI-shaped endpoint"]
      R_WEBAUTHN["webauthn.py — passkey ceremonies"]
      R_USAGE["src/usage_log.py (vendored) — /api/usage\nlocal view/tap log"]
    end
  end
  WEBAPPCMD --> MGR
  WEBAPPPROC --> WSERVER
  WSERVER --> routers
  MGR --> WSERVER
  WSERVER -->|"lifespan doorbell tick, canonical only"| DOORBELL

  subgraph static["app/webapp/static/ — vanilla JS PWA (Android first)"]
    STATICJS["index.html, tabs.js, state.js,\nsession-overlay.js over terminal.js + terminal/\n+ chat/ (Chat view), composer.js,\nsessions.js, jobs.js + jobs/, board.js + board/,\napps.js + apps/, team-os.js, settings/"]
  end
  R_MISC --> STATICJS

  subgraph sessionhost["app/webapp/session_host/ — loopback-only, :8466"]
    HOSTSERVER["server.py\nPOST/GET /sessions, WS /sessions/{sid}/ws"]
  end
  HOSTCMD --> HOSTSERVER
  HOSTPROC --> HOSTSERVER

  subgraph srclib["src/ — shared library"]
    SESSHOST["session_host.py + session_hosting/\nPtySession + SessionManager, detached RemoteSession\nConPTY via pywinpty (Windows-only)"]
    AGENTS["agents.py\nagent registry: copilot only"]
    FLAGS["launching/flags.py\nbuild_copilot_flags: --model, --effort, --context,\n--autopilot, --allow-all"]
    SESSCLIENT["clients/session.py\nHTTP client to the session-host over loopback"]
    FORGE["clients/gitlab.py\nglab api reads (issues, MRs, done today)\nand writes (file issue, note); cached snapshot,\nnever on a poll"]
    BOARD["board/\nassembly: sessions + jobs + GitLab snapshot,\nowner checks, proof reports, claims"]
    CHIEF["chief/\nplan, journal, answers, dispatch brief, identity"]
    JOBS["jobs/ + jobs_kinds/\nTask Scheduler \\AppLauncherLite\\, runs, coverage"]
    SCANNER["scanner.py + registry.py\nproject dirs, *.bat classify, team-os skills,\nrepo web/issues URL for any host"]
    CONFIG["webapp_config.py + webapp_settings/\nWebappConfig dataclass + validation"]
  end
  HOSTSERVER --> SESSHOST
  SESSHOST --> AGENTS
  R_APPS --> FLAGS
  R_TEAMOS --> FLAGS
  R_BOARD --> FLAGS
  R_APPS --> SESSCLIENT
  R_BOARD --> SESSCLIENT
  R_TEAMOS --> SESSCLIENT
  R_BOARD --> BOARD
  R_BOARD --> FORGE
  R_PROGRESS --> FORGE
  R_BOARD --> CHIEF
  R_JOBS --> JOBS
  R_CONFIG --> CONFIG
  R_APPS --> SCANNER
  R_TEAMOS --> SCANNER
  SESSCLIENT --> HOSTSERVER

  subgraph ext["external"]
    COPILOT["copilot CLI\n(the coding agent, spawned in a PTY)"]
    GLAB["glab CLI / GitLab REST v4"]
    SCHTASKS["Windows Task Scheduler"]
    FCL["fleet-config-lite (sibling)\nCopilot hooks: ~/.copilot/hooks/state/\nsessions-state.json, active-issues.json;\n/issue-start, /issue-yolo skills"]
    TEAMOSREPO["team-os repo (sibling)\n.claude/skills"]
  end
  COPILOTSIDE["copilot/ — the Copilot side\nhooks, chief helpers, lane skills\ncopied from fleet-config-lite (provenance.json);\nthe chief's working folder, read by the Board"]
  COPILOTSIDE -.->|copy of| FCL
  SESSHOST --> COPILOT
  FORGE --> GLAB
  JOBS --> SCHTASKS
  BOARD -->|reads| COPILOTSIDE
  FCL -.->|hooks write state| BOARD
  SCANNER --> TEAMOSREPO
