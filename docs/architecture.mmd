  subgraph external["External dependencies"]
    SCHTASKS["Windows Task Scheduler\n(\\AppLauncher\\ folder)"]
    GL["glab CLI / GitLab"]
    TEAMOSREPO["team-os repo (sibling)\nskills invoked via copilot session"]
