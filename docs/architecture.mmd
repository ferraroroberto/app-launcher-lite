%% docs/architecture.mmd — app-launcher's own internal structure.
%% Hand-authored, not generated — this repo's internal shape is semantic and
%% can't be crawled the way the fleet-wide map is. Update this diagram in the
%% same PR as any material structural change (a new tab/router, a process
%% split like session-host, a script relocated) — same anti-staleness
%% contract as this repo's own `.fleet.toml` `description` field. See
%% fleet-config's `CLAUDE.md` "Every repo carries a `.fleet.toml`" section
%% for the general convention (companion to `ferraroroberto/fleet-config#256`).

flowchart TB
  ENTRY["launcher.py (root)\nputs repo root on sys.path"] --> CLIMAIN["app/cli/main.py"]

  subgraph cli["app/cli/commands/"]
    TRAYCMD["tray_cmd.py"]
    WEBAPPCMD["webapp_cmd.py"]
    HOSTCMD["session_host_cmd.py"]
    SCANCMD["scan_cmd.py"]
    RUNJOBCMD["run_job_cmd.py\n(job executor)"]
  end
  CLIMAIN --> TRAYCMD
  CLIMAIN --> WEBAPPCMD
  CLIMAIN --> HOSTCMD
  CLIMAIN --> SCANCMD
  CLIMAIN --> RUNJOBCMD

  subgraph tray["app/tray/ — tray.py + single_instance.py"]
    TRAY["tray.py\nmenu: open/copy URL, restart, status, quit"]
    TRAYTS["tailscale.py\nCLI discovery + hostname resolution"]
    TRAYREGTRAYS["registered_trays.py\nautostart boot sequence (#456)"]
  end
  TRAYCMD --> TRAY
  TRAY --> TRAYTS
  TRAY --> TRAYREGTRAYS

  TRAY -->|spawns, owns subtree :T kill/T restart| WEBAPPPROC["webapp process :8445"]
  TRAY -->|spawns DETACHED, re-adopts on start\nexcluded from tray reclaim sweep| HOSTPROC["session-host process :8446"]
  TRAY -->|optional| TUNNEL["cloudflared tunnel"]

  subgraph webapp["app/webapp/ — FastAPI, :8445"]
    WSERVER["server.py\nlifespan, static mount, asset hashing"]
    MW["middleware.py\nBearerTokenMiddleware"]
    MGR["manager.py\nWebappManager (start/stop/status)"]
    subgraph routers["routers/"]
      R_MISC["misc.py — /, /healthz, /api/version"]
      R_AUTH["auth.py — /api/login"]
      R_CONFIG["config.py — /api/config, /api/status, /api/ports"]
      R_TOKENS["tokens.py — /api/tokens\nscoped-token mint/list/revoke (#72)"]
      R_APPS["apps.py — /api/apps (Apps tab)"]
      R_SESS["sessions.py — /api/coding/sessions, WS"]
      R_CC["coding.py — flags, git-status, favorites"]
      R_JOBS["jobs.py + jobs_run_store_routes.py\n/api/jobs/* (Jobs tab)"]
      R_TEAMOS["team_os.py — /api/team-os/* (Team OS tab)"]
      R_BOARD["board.py — /api/board (Board tab) + dispatch\n+ board_spawn.py (shared spawn-then-type)"]
      R_WEBAUTHN["webauthn.py — passkey ceremonies"]
    end
  end
  WEBAPPCMD --> MGR
  WEBAPPPROC --> WSERVER
  WSERVER --> MW
  WSERVER --> routers
  MGR --> WSERVER

  subgraph static["app/webapp/static/ — vanilla JS PWA"]
    STATICJS["index.html, tabs.js, state.js,\nterminal*.js, sessions.js, jobs*.js,\nboard*.js, apps.js, team-os.js"]
  end
  R_MISC --> STATICJS

  subgraph sessionhost["app/session_host/ — loopback-only, :8446"]
    HOSTSERVER["server.py\nHTTP + WebSocket surface\nPOST/GET /sessions, WS /sessions/{sid}/ws"]
  end
  HOSTCMD --> HOSTSERVER
  HOSTPROC --> HOSTSERVER

  subgraph srclib["src/ — shared library"]
    SESSHOST["session_host.py\nPtySession + SessionManager\nConPTY via winpty (Windows-only)"]
    VTSNAP["vt_snapshot.py\nheadless pyte VT mirror per\nfullscreen session — reconnect snapshot"]
    AGENTS["agents.py\nagent registry: copilot (+ ssh, loopback-only)"]
    SESSCLIENT["session_client.py\nHTTP client → session-host over loopback"]
    REGISTRY["registry.py\nconfig/apps.json load/save/scan"]
    SCANNER["scanner.py\nfs scan: project dirs + *.bat classify"]
    JOBSFACADE["jobs.py (facade)"]
    JOBSCFG["jobs_config.py"]
    JOBSSCHTASKS["jobs_schtasks.py\nWindows Task Scheduler sync"]
    JOBSQUEUE["jobs_queue.py\ncross-job mutex queue"]
    JOBSHISTORY["jobs_history.py\nrun.json / output.log per run"]
    JOBSINDEX["jobs_index.py\nderived SQLite + FTS5 run mirror"]
    JOBSSTATS["jobs_stats.py\npercentiles, health, stuck detection"]
    JOBSCOVERAGE["jobs_coverage.py\nmissed-fire coverage (#697)"]
    JOBSPREFLIGHT["jobs_preflight.py"]
    JOBSARGV["jobs_argv.py"]
    JOBSTRIGGER["jobs_trigger.py\n--trigger vocabulary (scheduled/manual/webhook/chain:)"]
    BOARD["board.py\npure assembly: sessions + GitLab"]
    GLCLIENT["gitlab_client.py\nglab CLI reads, cached snapshot"]
    NOTIFY["notifications.py\nPushover on job failure"]
    WEBAPPCFG["webapp_config.py\nconfig/webapp_config.json"]
    LAUNCHFLAGS["launch_flags.py\nper-agent CLI flag builders"]
    APITOKENS["api_tokens.py\nscoped-token mint/hash/scope (#72)"]
    JOBSSECRETS["jobs_secrets.py\n$secret: reference resolution (#72/#73)"]
    APPCFG["app_config.py\nconfig/config.json"]
    WEBAUTHNGATE["webauthn_gate.py"]
    STATICVER["static_versioning.py\nasset content-hash stamping"]
    DIAG["diagnostics.py\nring log buffer, port_owner"]
    JSONIO["_json_io.py"]
    LOOPHTTP["_loopback_http.py"]
    AUDIT["audit.py\ntranscript_path"]
  end

  HOSTSERVER --> SESSHOST
  SESSHOST --> VTSNAP
  SESSHOST --> AGENTS
  R_SESS --> SESSCLIENT
  SESSCLIENT -->|HTTP + WS, loopback| HOSTSERVER
  R_APPS --> REGISTRY
  R_APPS --> SCANNER
  R_JOBS --> JOBSFACADE
  RUNJOBCMD --> JOBSFACADE
  RUNJOBCMD --> NOTIFY
  JOBSFACADE --> JOBSSCHTASKS
  JOBSFACADE --> JOBSQUEUE
  JOBSFACADE --> JOBSHISTORY
  R_JOBS --> JOBSINDEX
  JOBSINDEX --> JOBSHISTORY
  JOBSFACADE --> JOBSSTATS
  JOBSFACADE --> JOBSCOVERAGE
  JOBSCOVERAGE --> JOBSSCHTASKS
  JOBSCOVERAGE --> JOBSHISTORY
  JOBSCOVERAGE --> NOTIFY
  WSERVER -->|"lifespan coverage tick (#697)"| JOBSCOVERAGE
  JOBSFACADE --> JOBSCFG
  JOBSFACADE --> JOBSPREFLIGHT
